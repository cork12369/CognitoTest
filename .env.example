# Looply's CognitioLabs OpenRouter gateway configuration.
# Keep these values server-side only; never prefix them with NEXT_PUBLIC_.
# The console password is retained for your own setup reference only and is not used by the app.
CLASSGW_BASE_URL=https://174.138.16.223/openrouter/v1
CLASSGW_KEY=YOUR_CLASSGW_KEY
AI_GATEWAY_CONSOLE_PASSWORD=YOUR_CONSOLE_PASSWORD
AI_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small